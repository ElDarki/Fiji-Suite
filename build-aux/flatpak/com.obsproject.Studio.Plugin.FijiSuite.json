{
  "id": "com.obsproject.Studio.Plugin.FijiSuite",
  "runtime": "com.obsproject.Studio",
  "runtime-version": "stable",
  "sdk": "org.freedesktop.Sdk//26.08",
  "branch": "stable",
  "build-extension": true,
  "separate-locales": false,
  "appstream-compose": false,
  "build-options": {
    "prefix": "/app/plugins/FijiSuite",
    "cflags": "-Wno-error=deprecated-declarations",
    "cxxflags": "-Wno-error=deprecated-declarations",
    "prepend-path": "/app/bin",
    "prepend-ld-library-path": "/app/lib",
    "prepend-pkg-config-path": "/app/lib/pkgconfig"
  },
  "modules": [
    {
      "name": "fiji-suite",
      "buildsystem": "cmake-ninja",
      "builddir": true,
      "config-opts": [
        "-DCMAKE_BUILD_TYPE=RelWithDebInfo",
        "-DCMAKE_PREFIX_PATH=/app",
        "-DCMAKE_INSTALL_LIBDIR=lib",
        "-DQT_VERSION=6",
        "-DENABLE_FRONTEND_API=OFF",
        "-DENABLE_QT=OFF"
      ],
      "post-install": [
        "install -Dm644 -t ${FLATPAK_DEST}/share/metainfo ../${FLATPAK_ID}.metainfo.xml"
      ],
      "sources": [
        { "type": "dir", "path": "../.." },
        { "type": "file", "path": "com.obsproject.Studio.Plugin.FijiSuite.metainfo.xml" }
      ]
    }
  ]
}
