@OBSThemeMeta {
    name: 'Fiji Sun';
    id: 'com.fijisuite.Fiji.Sun';
    extends: 'com.obsproject.Yami.Light';
    author: 'darkzeromex';
    dark: 'false';
}

/* Fiji-chan by day: warm sand, sea-glass teal, ink text. Colours from the Fiji-chan style guide v1.1 (Sun mood).
   Works with OBS 31, 32 and 33. Built on Yami Light, so every OBS control and icon keeps its usual shape; only colour, corners and type change.
   Installed by the Fiji Suite plugin. Pick it in Settings → Appearance. */

@OBSThemeVars {
    /* sand ramp (Yami's grey slots: 1 = lines, 2-4 = controls, 6 = panels, 7 = window, 8 = preview) */
    --grey1: #98837b;
    --grey2: #ffffff;
    --grey3: #fffcf8;
    --grey4: #fffcf8;
    --grey5: #f3ebe3;
    --grey6: #fbf6f0;
    --grey7: #efe5db;
    --grey8: #e2d4c6;

    /* sea-glass teal: soft enough that ink text reads on it (selections, checked buttons, Live) */
    --primary: #a3cfc7;
    --primary_light: #c4e1dc;
    --primary_lighter: #167a71;
    --primary_dark: #7fb9b0;
    --primary_darker: #5ea79d;

    /* OBS blue (sliders, progress bars, mixer labels) becomes her sea-glass teal */
    --blue1: #167a71;
    --blue2: #167a71;
    --blue3: #11655e;
    --blue4: #0c534d;
    --blue5: #0a3f3a;
    --blue6: #d8ece8;

    /* OBS 31-32 read these; 33 colours the labels directly (rules at the end) */
    --warning: #8f5000;
    --danger: #bd2748;

    --text: #2b2230;
    --text_light: #574a59;
    --text_muted: #6b5e6c;
    --text_disabled: #8a7d86;
    --text_inactive: #574a59;

    --border_color: #e6d9cc;
    --border_radius: 8px;
    --border_radius_small: 4px;
    --border_radius_large: 12px;

    --input_bg: var(--grey4);
    --input_border: #d3c2b4;
    --input_border_hover: #98837b;
    --input_border_focus: #167a71;

    --button_bg: #fffcf8;
    --button_bg_hover: #ffffff;
    --button_bg_down: #e9ddd1;
    --button_bg_disabled: #efe5db;
    --button_border: #e6d9cc;
    --button_border_hover: #98837b;
    --button_border_focus: #167a71;

    /* the selected tab gets her straw-gold underline */
    --tab_border_selected: #d0802f;

    --highlight_color: #167a71;

    --separator_hover: #167a71;

    --scrollbar_handle: #e6d9cc;
    --scrollbar_hover: #d3c2b4;
    --scrollbar_down: #98837b;
    --scrollbar_border: #efe5db;

    --palette_link: #10675f;
    --palette_linkVisited: #10675f;
    --palette_highlightedText: #2b2230;
}

/* her type: Nunito Sans for text, Zen Maru Gothic for headings and dock titles (bundled by Fiji Suite;
   OBS's Open Sans is the fallback when the plugin is not loaded) */
QWidget {
    font-family: 'Nunito Sans', 'Open Sans', '.AppleSystemUIFont', Helvetica, Arial, 'MS Shell Dlg', sans-serif;
}

.text-heading,
QDockWidget {
    font-family: 'Zen Maru Gothic', 'Nunito Sans', 'Open Sans', sans-serif;
}

.text-bright {
    color: #10675f;
}

.text-success {
    color: #18733f;
}

.text-warning {
    color: #8f5000;
}

.text-danger {
    color: #bd2748;
}

/* Fiji Suite's multiview: the on-air border and the dropped-frames warning */
CanvasTile {
    qproperty-liveColor: #c8243f;
    qproperty-warningColor: #8f5000;
}
