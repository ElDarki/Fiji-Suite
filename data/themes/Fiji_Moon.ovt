@OBSThemeMeta {
    name: 'Fiji Moon';
    id: 'com.fijisuite.Fiji.Moon';
    extends: 'com.obsproject.Yami';
    author: 'darkzeromex';
    dark: 'true';
}

/* Fiji-chan by night: a cold moonlit indigo with one warm lantern glow (the selected tab and the focus of a
   field you are typing in). Colours from the Fiji-chan style guide v1.1 (Moon mood).
   Works with OBS 31, 32 and 33. Built on Yami, so every OBS control and icon keeps its usual shape; only colour, corners and type change.
   Installed by the Fiji Suite plugin. Pick it in Settings → Appearance. */

@OBSThemeVars {
    /* night ramp (Yami's grey slots: 1 = lines, 2-4 = controls, 6 = panels, 7 = window, 8 = preview) */
    --grey1: #6f68a2;
    --grey2: #4a437e;
    --grey3: #3d3770;
    --grey4: #2e2955;
    --grey5: #231f46;
    --grey6: #1a1738;
    --grey7: #110f29;
    --grey8: #0a081f;

    /* deep sea teal: dark enough that moon-white text reads on it (selections, checked buttons, Live) */
    --primary: #175a69;
    --primary_light: #1d6878;
    --primary_lighter: #62d9c9;
    --primary_dark: #124a57;
    --primary_darker: #0e3b45;

    /* OBS blue (sliders, progress bars, mixer labels) becomes moonlit teal */
    --blue1: #8ee6da;
    --blue2: #62d9c9;
    --blue3: #2a9a8e;
    --blue4: #1d6878;
    --blue5: #124a57;
    --blue6: #0e3b45;

    /* OBS 31-32 read these; 33 colours the labels directly (rules at the end) */
    --warning: #ffd27a;
    --danger: #ff8fa1;

    --text: #f1eefc;
    --text_light: #cbc6ea;
    --text_muted: #b9b3de;
    --text_disabled: #8d87b8;
    --text_inactive: #f1eefc;

    --border_color: #322c5e;
    --border_radius: 8px;
    --border_radius_small: 4px;
    --border_radius_large: 12px;

    --input_bg: var(--grey4);
    --input_bg_hover: #231f46;
    --input_bg_focus: #231f46;
    --input_border: #4a437e;
    --input_border_hover: #6f68a2;
    --input_border_focus: #e8bf78;

    --button_bg: var(--grey4);
    --button_bg_hover: var(--grey3);
    --button_bg_down: var(--grey7);
    --button_bg_disabled: var(--grey6);
    --button_border: var(--grey4);
    --button_border_hover: #6f68a2;
    --button_border_focus: #62d9c9;

    /* the lantern: the selected tab glows warm */
    --tab_border_selected: #e8bf78;

    --highlight_color: #62d9c9;

    --separator_hover: #e8bf78;

    --scrollbar_handle: #2e2955;
    --scrollbar_bg: #1a1738;
    --scrollbar_hover: #3d3770;
    --scrollbar_down: #4a437e;
    --scrollbar_border: #322c5e;

    --palette_light: #4a437e;
    --palette_link: #7fe3d7;
    --palette_linkVisited: #7fe3d7;
}

/* her type: Nunito Sans for text, Zen Maru Gothic for headings and dock titles (bundled by Fiji Suite;
   OBS's Open Sans is the fallback when the plugin is not loaded) */
QWidget {
    font-family: 'Nunito Sans', 'Open Sans', '.AppleSystemUIFont', Helvetica, Arial, 'MS Shell Dlg', sans-serif;
}

.text-heading,
QDockWidget {
    font-family: 'Zen Maru Gothic', 'Nunito Sans', 'Open Sans', sans-serif;
}

.text-bright {
    color: #7fe3d7;
}

.text-success {
    color: #7fe0a0;
}

.text-warning {
    color: #ffd27a;
}

.text-danger {
    color: #ff8fa1;
}

/* Fiji Suite's multiview: the on-air border and the dropped-frames warning */
CanvasTile {
    qproperty-liveColor: #ff7a93;
    qproperty-warningColor: #ffd27a;
}
