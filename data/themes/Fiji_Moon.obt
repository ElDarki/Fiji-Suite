@OBSThemeMeta {
    name: 'Fiji Moon';
    id: 'com.fijisuite.Fiji.Moon';
    extends: 'com.obsproject.Yami';
    author: 'darkzeromex';
    dark: 'true';
}

/* Fiji-chan by night, a VIP lounge on the beach: midnight indigo, thin gold hairlines, Mincho headings,
   moonlit teal for every action.
   Generated by tools/build-themes.py from the Fiji-chan style guide v1.1; edit that script, not this file.
   A base theme (Settings → Appearance → Theme) built on Yami, so OBS's sizes and behaviour stay the same; the
   colours, shapes and type follow the guide. Works with OBS 31, 32 and 33. Installed by the Fiji Suite plugin. */

@OBSThemeVars {
    /* ---- Fiji Moon: colours from the Fiji-chan style guide v1.1 ---- */
    --grey1: #6f68a2;
    --grey2: #4a437e;
    --grey3: #3d3770;
    --grey4: #2e2955;
    --grey5: #231f46;
    --grey6: #1a1738;
    --grey7: #110f29;
    --grey8: #0a081f;

    --primary: #175a69;
    --primary_light: #1d6878;
    --primary_lighter: #62d9c9;
    --primary_dark: #124a57;
    --primary_darker: #0e3b45;

    /* OBS blue (sliders, progress, mixer labels) becomes her teal */
    --blue1: #8ee6da;
    --blue2: #62d9c9;
    --blue3: #2a9a8e;
    --blue4: #1d6878;
    --blue5: #124a57;
    --blue6: #0e3b45;

    /* OBS 31-32 read these; 33 colours the labels directly (rules below) */
    --warning: #ffd27a;
    --danger: #ff8fa1;

    --text: #f1eefc;
    --text_light: #cbc6ea;
    --text_muted: #b9b3de;
    --text_disabled: #8d87b8;
    --text_inactive: #cbc6ea;

    --border_color: #322c5e;
    --border_radius: 7px;
    --border_radius_small: 4px;
    --border_radius_large: 14px;

    --input_bg: #1a1738;
    --input_bg_hover: #1a1738;
    --input_bg_focus: #1a1738;
    --input_border: #6f68a2;
    --input_border_hover: #cbc6ea;
    --input_border_focus: #62d9c9;

    --button_bg: #1a1738;
    --button_bg_hover: #231f46;
    --button_bg_down: #2e2955;
    --button_bg_disabled: #231f46;
    --button_border: #6f68a2;
    --button_border_hover: #62d9c9;
    --button_border_focus: #62d9c9;

    --tab_border_selected: #62d9c9;
    --highlight_color: #62d9c9;
    --separator_hover: #62d9c9;

    --scrollbar_handle: #2e2955;
    --scrollbar_bg: #1a1738;
    --scrollbar_hover: #6f68a2;
    --scrollbar_down: #cbc6ea;
    --scrollbar_border: #322c5e;

    --palette_light: #4a437e;
    --palette_link: #7fe3d7;
    --palette_linkVisited: #7fe3d7;
    --palette_highlightedText: #f1eefc;
}

/* ==========================================================================
   Fiji Moon: her components (the guide's Components section), on Yami's sizes
   ========================================================================== */

/* her type: Nunito Sans for everything people operate; the display face only for headings */
QWidget {
    font-family: 'Nunito Sans', 'Open Sans', '.AppleSystemUIFont', Helvetica, Arial, 'MS Shell Dlg', sans-serif;
}

.text-heading, .text-title {
    font-family: 'Shippori Mincho B1', 'Nunito Sans', 'Open Sans', sans-serif;
}

/* ---- buttons: pills, Nunito Sans 700 ---- */
QPushButton {
    background-color: #1a1738;
    border: 1px solid #6f68a2;
    border-radius: 12px;
    font-weight: bold;
}
QPushButton:hover, QPushButton:focus {
    background-color: #231f46;
    border-color: #62d9c9;
}
QPushButton:pressed, QPushButton:pressed:hover {
    background-color: #2e2955;
    border-color: #62d9c9;
}
QPushButton:disabled {
    background-color: #231f46;
    border-color: #322c5e;
    color: #8d87b8;
}

/* switched on, and the live outputs: the primary look, a teal fill over a hard cel edge */
QPushButton:checked,
#streamButton:!hover:!pressed.state-active,
#recordButton:!hover:!pressed.state-active,
#pauseRecordButton:!hover:!pressed.state-active,
#replayBufferButton:!hover:!pressed.state-active,
#virtualCamButton:!hover:!pressed.state-active,
#modeSwitch:!hover:!pressed.state-active,
#broadcastButton:!hover:!pressed.state-active {
    background: #62d9c9;
    color: #04211e;
    border: 1px solid #62d9c9;
    border-bottom: 3px solid #2a9a8e;
}
QPushButton:checked:hover, QPushButton:checked:focus,
#streamButton:hover:!pressed.state-active,
#recordButton:hover:!pressed.state-active,
#pauseRecordButton:hover:!pressed.state-active,
#replayBufferButton:!pressed.state-active,
#virtualCamButton:!pressed.state-active,
#modeSwitch:hover:!pressed.state-active,
#broadcastButton:hover:!pressed.state-active {
    background: #8ee6da;
    color: #04211e;
    border: 1px solid #8ee6da;
    border-bottom: 3px solid #2a9a8e;
}

/* icon buttons */
QToolButton, .btn-tool {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 7px;
}
QToolButton:hover, QToolButton:focus, .btn-tool:hover, .btn-tool:focus {
    background-color: #231f46;
    border-color: #6f68a2;
}
QToolButton:pressed, QToolButton:pressed:hover, .btn-tool:pressed, .btn-tool:pressed:hover {
    background-color: #2e2955;
    border-color: #62d9c9;
}
QToolButton:checked, .btn-tool:checked {
    background-color: #26364f;
    border-color: #62d9c9;
}
QToolButton:disabled, .btn-tool:disabled {
    background-color: transparent;
    border-color: transparent;
}

/* ---- fields: a visible line, teal on focus ---- */
QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QDateTimeEdit, QSpinBox, QDoubleSpinBox {
    background-color: #1a1738;
    border: 1px solid #6f68a2;
    border-radius: 7px;
}
QLineEdit:hover, QTextEdit:hover, QPlainTextEdit:hover, QComboBox:hover, QDateTimeEdit:hover,
QSpinBox:hover, QDoubleSpinBox:hover {
    border-color: #cbc6ea;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QComboBox:focus, QDateTimeEdit:focus,
QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:on {
    border-color: #62d9c9;
}
QLineEdit:read-only, QLineEdit:read-only:hover, QLineEdit:read-only:focus {
    background-color: #231f46;
    border-color: #322c5e;
}
QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled, QComboBox:disabled, QSpinBox:disabled,
QDoubleSpinBox:disabled {
    background-color: #231f46;
    border-color: #322c5e;
}
QComboBox QAbstractItemView {
    background-color: #1a1738;
    border: 1px solid #89725a;
}

/* ---- checkboxes: her rounded square, teal when ticked ---- */
QCheckBox::indicator:unchecked, QGroupBox::indicator:unchecked, QTableView::indicator:unchecked {
    image: url(theme:FijiMoon/checkbox_unchecked.svg);
}
QCheckBox::indicator:unchecked:hover, QGroupBox::indicator:unchecked:hover, QTableView::indicator:unchecked:hover {
    image: url(theme:FijiMoon/checkbox_unchecked_focus.svg);
}
QCheckBox::indicator:checked, QGroupBox::indicator:checked, QTableView::indicator:checked {
    image: url(theme:FijiMoon/checkbox_checked.svg);
}
QCheckBox::indicator:checked:hover, QGroupBox::indicator:checked:hover, QTableView::indicator:checked:hover {
    image: url(theme:FijiMoon/checkbox_checked_focus.svg);
}
QCheckBox::indicator:checked:disabled, QGroupBox::indicator:checked:disabled, QTableView::indicator:checked:disabled {
    image: url(theme:FijiMoon/checkbox_checked_disabled.svg);
}
QCheckBox::indicator:unchecked:disabled, QGroupBox::indicator:unchecked:disabled,
QTableView::indicator:unchecked:disabled {
    image: url(theme:FijiMoon/checkbox_unchecked_disabled.svg);
}

/* OBS 32 and later: settings switches are teal when on */
idian--ToggleSwitch {
    qproperty-background_checked: #62d9c9;
    qproperty-background_checked_hover: #8ee6da;
}

/* ---- lists and menus: the selected row is a chip, a teal outline on soft teal ---- */
QListView::item:hover, QListWidget::item:hover, QMenu::item:hover {
    background: #231f46;
    border: 1px solid #322c5e;
}
QMenu::item:selected, QMenu > QWidget:selected, QListView::item:selected, QListWidget::item:selected,
QMenu::item:selected:hover, QListView::item:selected:hover, QListWidget::item:selected:hover {
    background-color: #26364f;
    border: 1px solid #62d9c9;
    color: #7fe3d7;
}
.list-grid SceneTree::item:selected {
    background-color: #26364f;
}
.list-grid SceneTree::item:checked {
    background-color: #62d9c9;
    color: #04211e;
}

QMenu, QMenu > QMenu {
    background-color: #1a1738;
    border: 1px solid #89725a;
}
QMenuBar::item:selected {
    background: #26364f;
    color: #7fe3d7;
    border-radius: 7px;
}
QToolTip {
    background-color: #1a1738;
    color: #f1eefc;
    border: 1px solid #89725a;
    padding: 4px 8px;
}

/* ---- tabs: chips ---- */
QTabWidget::pane {
    border: none;
    border-top: 1px solid #322c5e;
}
QTabBar::tab, QTabBar::tab:top, QTabBar::tab:bottom {
    background: #1a1738;
    color: #cbc6ea;
    border: 1px solid #6f68a2;
    border-radius: 12px;
    font-weight: bold;
    margin: 2px 4px 4px 0px;
}
QTabBar::tab:hover {
    background: #231f46;
    border-color: #62d9c9;
    color: #f1eefc;
}
QTabBar::tab:selected {
    background: #26364f;
    border-color: #62d9c9;
    color: #7fe3d7;
}

/* ---- docks are her panels: ink by day, a gold hairline by night, the title in her display face ---- */
QDockWidget {
    font-family: 'Shippori Mincho B1', 'Nunito Sans', 'Open Sans', sans-serif;
    color: #f1eefc;
}
QDockWidget::title {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #252342, stop:0.45 #1a1738);
    border: none;
    border-bottom: 1px solid #89725a;
}

/* group boxes are cards */
QGroupBox {
    background: #1a1738;
    border: 1px solid #322c5e;
    border-radius: 14px;
    font-family: 'Shippori Mincho B1', 'Nunito Sans', 'Open Sans', sans-serif;
}

/* ---- sliders, scroll bars, progress ---- */
QSlider::sub-page:horizontal, QSlider::add-page:vertical {
    background-color: #62d9c9;
}
QSlider::handle:horizontal, QSlider::handle:vertical {
    background-color: #1a1738;
    border: 2px solid #62d9c9;
    border-radius: 8px;
}
QSlider::handle:horizontal {
    width: 12px;
    height: 12px;
    margin: -6px 0;
}
QSlider::handle:vertical {
    width: 12px;
    height: 12px;
    margin: 0 -6px;
}
QSlider::handle:hover {
    background-color: #26364f;
}
QSlider::handle:pressed {
    background-color: #62d9c9;
}
QScrollBar::handle {
    border-radius: 5px;
}
QProgressBar {
    border-radius: 7px;
}
QProgressBar::chunk {
    background: #62d9c9;
    border: none;
    border-bottom: 2px solid #2a9a8e;
    border-radius: 7px;
}

/* ---- states: always with a word (OBS 33 colours these labels directly) ---- */
.text-bright {
    color: #7fe3d7;
}
.text-success {
    color: #7fe0a0;
}
.text-warning {
    color: #ffd27a;
}
.text-danger {
    color: #ff8fa1;
}

/* Fiji Suite's multiview: the on-air border and the dropped-frames warning */
CanvasTile {
    qproperty-liveColor: #ff7a93;
    qproperty-warningColor: #ffd27a;
}
